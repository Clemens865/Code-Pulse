# Local development defaults; copy to .env and adjust.
NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Postgres connection string. The included docker-compose.yml exposes Postgres
# on localhost:56432 with these credentials (55432, not 5432, so we don't
# collide with a host Postgres on the standard port).
DATABASE_URL=postgres://cpt:cpt@localhost:56432/cpt_dev

# Server-side pepper used to HMAC API keys before storage. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_PEPPER=replace-with-32-bytes-of-random-hex

# Health endpoint shared secret used by the synthetic canary.
HEALTH_DEEP_TOKEN=replace-with-random-token

# Allowed origins for the dashboard. Comma-separated.
DASHBOARD_ORIGINS=http://localhost:3142,http://localhost:3000

# Cookie-signing secret for dashboard sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-32-bytes-of-random-hex

# Local (identity-picker) login for the dashboard: auto | true | false.
# "auto" = enabled outside production. Self-hosters running production
# without OAuth set true (only behind a trusted network / auth proxy).
LOCAL_LOGIN=auto

# Open blockers not re-asserted within this many days auto-resolve as stale.
# 0 disables the sweep.
# BLOCKER_STALE_DAYS=14

# Optional: enables LLM pattern auto-suggest. Absent = feature off, no errors.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
